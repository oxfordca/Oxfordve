<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Principal: Hereda de account.view_move_form -->
        <record id="tsc_view_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit.tsc</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <!-- Prioridad 100 para ejecutarse DESPUÉS de Studio (Secuencia 99) -->
            <field name="priority">100</field>
            <field name="arch" type="xml">

                <!-- Inyección del campo invisible antes del header -->
                <xpath expr="//form/header" position="before">
                    <field name="tsc_is_restricted_user" invisible="1"/>
                </xpath>

                <!-- Bloqueo de cabecera estándar -->
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='payment_reference']" position="attributes">
                    <attribute name="attrs">{'readonly': [('tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
              
                <!-- Campo Rama -->
                <xpath expr="//div[@name='branch_div']/field[@name='branch_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>

                <!-- Campo Moneda -->
                <xpath expr="//field[@name='currency_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>

                <!-- Bloqueo de columnas en líneas de factura (tax_ids se mantiene editable) -->
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_uom_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>

            </field>
        </record>

        <!-- Vista Secundaria: Hereda de sale.account_invoice_form exclusivamente para la dirección de entrega -->
        <record id="tsc_view_move_form_inherit_sale" model="ir.ui.view">
            <field name="name">account.move.form.inherit.tsc.sale</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="sale.account_invoice_form"/>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('tsc_is_restricted_user', '=', True)]}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>